{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "Build shared lua",
			"detail": "Build lua shared",
			"command": "make -C ${workspaceFolder} shared && exit",
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "Build static lua",
			"detail": "Build lua shared",
			"command": "make -C ${workspaceFolder} static && exit",
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "Build syscalls",
			"detail": "Build syscals library",
			"command": "make -C ${workspaceFolder} syscalls.dll && exit",
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"label": "Clean",
			"detail": "Clean build",
			"command": "make -C ${workspaceFolder} clean && exit",
			"group": {
				"kind": "build",
				"isDefault": false
			}
		},
		
	],
	"windows": {
		"options": {
			"shell": {
				"executable": "cmd",
				"args": [
					"/k",
				],
			},
		}
	}
}